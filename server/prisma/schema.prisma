// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid()) //This generates a long, secure, collision-resistant string (e.g., clq5z...), instead of ids 1, 2 ,3, ....
  email       String   @unique
  password    String
  username    String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- NEW PROFILE FIELDS ---
  bio         String?
  avatarUrl   String?
  githubUrl   String?

  // --- NEW: Relationships to Content ---
  posts    Post[]
  comments Comment[]
  likes    Like[]

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")
}

model Post {
  id          String   @id @default(uuid())
  title       String
  description String
  githubUrl   String?
  liveUrl     String?
  tags        String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id      String @id @default(uuid())
  content String

  // Who wrote the comment?
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Which post is it on?
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Like {
  id String @id @default(uuid())

  // Who clicked like?
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What post did they like?
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Ensure a user can only like a specific post ONE time
  @@unique([userId, postId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}
